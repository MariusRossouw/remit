{
  "tools": [
    {
      "name": "findTables",
      "description": "Find free tables for a date and party size.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "party": {
            "type": "integer"
          }
        },
        "required": [
          "date",
          "party"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Slot"
            }
          }
        },
        "required": [
          "slots"
        ],
        "$defs": {
          "Slot": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "start": {
                "type": "string",
                "format": "date-time"
              },
              "seats": {
                "type": "integer"
              },
              "deposit": {
                "$ref": "#/$defs/Money"
              }
            },
            "required": [
              "id",
              "start",
              "seats",
              "deposit"
            ]
          },
          "Money": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              }
            },
            "required": [
              "amount",
              "currency"
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
