"A shop."
service Shop {
  "Buy one item."
  action buy(item: Text) -> Text
    effects: spend(max: 50 ZAR)
    undo: refund

  "Return an item."
  action refund(receipt: Text)
    effects: write
}

"Buy things."
grant Shopping {
  allow Shop.buy where times <= 100
  expires 2026-11-13T23:59+02:00
}
