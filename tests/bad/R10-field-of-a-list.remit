type Slot { id: Text  start: DateTime }

"A restaurant."
service Bistro {
  "Reserve tables."
  action book(slots: List<Slot>) -> Text
    effects: write
    undo: cancel

  "Cancel a booking."
  action cancel(booking: Text)
    effects: write
}

"Book dinner."
grant Dinner {
  allow Bistro.book where slots.id == "s1"
  expires 2026-11-13T23:59+02:00
}
